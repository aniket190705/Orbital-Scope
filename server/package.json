{
  "name": "orbital-scope-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "prisma:generate": "node ./scripts/run-prisma.mjs generate --schema ../prisma/schema.prisma",
    "prisma:migrate": "node ./scripts/run-prisma.mjs migrate dev --schema ../prisma/schema.prisma",
    "prisma:deploy": "node ./scripts/run-prisma.mjs migrate deploy --schema ../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "redis": "^5.1.0",
    "satellite.js": "^6.0.1",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
